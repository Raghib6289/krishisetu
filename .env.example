# KrishiSetu Environment Configuration Template
# Copy this file to .env and insert your database credentials

# Neon Serverless PostgreSQL Database URL (or local PostgreSQL / leave empty for SQLite fallback)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini LLM API Key for KrishiSetu Sahayak Farmer Chatbot
GEMINI_API_KEY=your_gemini_api_key_here
